<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-browserwasm;net10.0-desktop</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>

    <!-- Disable hot reload features to avoid compatibility issues with prerelease packages -->
    <UseWasmDevelopmentServer>false</UseWasmDevelopmentServer>
    <WasmShellWebAppBasePath>/</WasmShellWebAppBasePath>

    <!-- Display name -->
    <ApplicationTitle>Uno.DevTools.Telemetry.WasmTests</ApplicationTitle>
    <!-- App Identifier -->
    <ApplicationId>com.companyname.uno-devtools-telemetry-wasmtests</ApplicationId>
    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <!-- Package Publisher -->
    <ApplicationPublisher>Uno.DevTools.Telemetry.WasmTests</ApplicationPublisher>
    <!-- Package Description -->
    <Description>Uno.DevTools.Telemetry.WasmTests powered by Uno Platform.</Description>

    <!--
      UnoFeatures are used to quickly add and manage features enabled for your app.
      https://aka.platform.uno/singleproject-features
    -->
    <UnoFeatures>
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Uno.DevTools.Telemetry\Uno.DevTools.Telemetry.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Uno.UI.RuntimeTests.Engine" />
  </ItemGroup>

</Project>
